{
  "name": "alaminn-info",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "description": "alaminn.info — Premium executive authority platform for Al Aminn (Next.js 16 standalone production build)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "node .next/standalone/server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/generate-prisma-client.mjs",
    "db:push": "node scripts/migrate-sqlite.mjs",
    "db:generate": "node scripts/generate-prisma-client.mjs",
    "db:validate": "prisma validate",
    "db:migrate": "node scripts/migrate-sqlite.mjs",
    "db:migrate:deploy": "node scripts/migrate-sqlite.mjs",
    "db:migrate:status": "node scripts/migrate-sqlite.mjs --check",
    "db:reset": "node -e \"console.error('Database reset is intentionally disabled. Restore a verified backup instead.'); process.exit(1)\"",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:backup": "npx tsx scripts/backup-db.ts",
    "db:restore": "npx tsx scripts/restore-db.ts",
    "db:verify": "npx tsx scripts/verify-db.ts",
    "security:test": "npx tsx scripts/security-tests.ts",
    "images:blur": "npx tsx scripts/generate-blur-placeholders.ts",
    "images:modern": "npx tsx scripts/generate-modern-images.ts",
    "images:optimize": "npx tsx scripts/generate-blur-placeholders.ts && npx tsx scripts/generate-modern-images.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/api",
    "test:api": "vitest run tests/api",
    "test:auth": "vitest run tests/lib/auth.test.ts tests/api/admin-auth.test.ts tests/unit/two-factor.test.ts",
    "test:booking": "npx tsx scripts/booking-workflow-tests.ts",
    "test:security": "npx tsx scripts/security-tests.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:production": "bash scripts/verify-production.sh",
    "docker:build": "docker build -t alaminn-info .",
    "docker:run": "docker run -d --name alaminn-app -p 3000:3000 --env-file .env alaminn-info",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "6.12.0",
    "@prisma/client": "6.12.0",
    "@prisma/internals": "6.12.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.525.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "10.1.2",
    "prisma": "6.12.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.3",
    "recharts": "^2.15.4",
    "sharp": "0.35.5",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
